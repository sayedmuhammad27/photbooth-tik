APP_NAME="Photobooth TIK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Zona waktu untuk tampilan jam di admin (data lama yang tersimpan di UTC akan tampil bergeser 7 jam)
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (XAMPP: nyalakan MySQL dulu, buat database kosong dengan nama di bawah) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=photobooth_tik_v2
DB_USERNAME=root
DB_PASSWORD=

# "file" membuat sesi login/CSRF tetap jalan walau MySQL sedang bermasalah
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# --- Photobooth ---
# Lama hitung mundur default (detik)
PHOTOBOOTH_COUNTDOWN=3
# Alamat yang dibuka ponsel pengunjung lewat QR code. Kosongkan bila booth dibuka lewat alamat yang sama.
# Contoh tunnel: https://abc123.ngrok-free.app   Contoh LAN: http://192.168.1.10:8000
PHOTOBOOTH_PUBLIC_URL=
# Akun admin untuk "php artisan db:seed". Kosongkan ADMIN_PASSWORD agar dibuatkan sandi acak (ditampilkan sekali).
ADMIN_EMAIL=admin@photobooth.tik
ADMIN_PASSWORD=
