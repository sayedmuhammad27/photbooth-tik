APP_NAME="Photobooth TIK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Zona waktu untuk tampilan jam di admin (data lama yang tersimpan di UTC akan tampil bergeser 7 jam)
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (XAMPP: nyalakan MySQL dulu, buat database kosong dengan nama di bawah) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=photobooth_tik_v2
DB_USERNAME=root
DB_PASSWORD=

# "file" membuat sesi login/CSRF tetap jalan walau MySQL sedang bermasalah
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# --- Photobooth ---
# Lama hitung mundur default (detik)
PHOTOBOOTH_COUNTDOWN=3
# Mode transisi antar foto (manual: tunggu klik Lanjut/spasi, auto: lanjut otomatis)
PHOTOBOOTH_ADVANCE_MODE=manual
# Alamat yang dibuka ponsel pengunjung lewat QR code. Kosongkan bila booth dibuka lewat alamat yang sama.
# Contoh tunnel: https://abc123.ngrok-free.app   Contoh LAN: http://192.168.1.10:8000
PHOTOBOOTH_PUBLIC_URL=
# Akun admin untuk "php artisan db:seed". Kosongkan ADMIN_PASSWORD agar dibuatkan sandi acak (ditampilkan sekali).
ADMIN_EMAIL=admin@photobooth.tik
ADMIN_PASSWORD=

# --- Kamera Canon lewat digiCamControl (opsional) ---
# true = tampilkan sumber "Canon (digiCamControl)" di halaman kamera. Wajib: digiCamControl berjalan di laptop yang sama,
# web server-nya aktif (File > Settings > Webserver), dan kamera dalam kualitas JPEG.
DIGICAM_ENABLED=false
DIGICAM_URL=http://127.0.0.1:5513
# Sumber awal bila DIGICAM_ENABLED=true: digicam atau webcam (pilihan operator diingat di browser)
DIGICAM_DEFAULT_SOURCE=digicam
DIGICAM_CAPTURE_TIMEOUT=25
DIGICAM_LIVE_INTERVAL=120

GEMINI_API_KEY=

# --- Integrasi Google Drive API (Opsional) ---
# Unggah otomatis hasil foto ke Google Drive
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
# Opsi 1: Google OAuth2 (Client ID, Client Secret, Refresh Token)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Opsi 2: Service Account JSON (Path file atau string JSON)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Opsi 3: Google Apps Script Webhook URL (Alternatif cepat)
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_AUTO_UPLOAD=true
